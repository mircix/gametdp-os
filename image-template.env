# Parameters for the GameTDP OS image build (read by the Justfile)

# Output image name: ghcr.io/<REPO_ORGANIZATION>/<IMAGE_NAME>
IMAGE_NAME=gametdp-os

REPO_ORGANIZATION="mircix"

IMAGE_DESC="GameTDP OS: a gaming-first Linux desktop for AMD PCs, built on Bazzite"
IMAGE_KEYWORDS="bootc,oci,linux,gaming,amd,bazzite,steam,proton"

IMAGE_LOGO_URL="https://raw.githubusercontent.com/mircix/gametdp-os/main/repo_content/logo.png"
# "stable" matches Bazzite's channel name, which its tools expect
DEFAULT_TAG="stable"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
